# ============================================================
# RAME — Environment Variables (copy ke .env lalu isi)
# ============================================================

# --- Database ---
# Lokal (prototype): SQLite — cukup, tanpa server
DATABASE_URL="file:./dev.db"
# VPS (produksi, Docker): PostgreSQL — Dockerfile mengganti provider
# schema.prisma ke postgresql secara otomatis saat build.
# DATABASE_URL="postgresql://rame:rame_password@db:5432/rame?schema=public"

# --- Session ---
# generate dengan: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-random-string-panjang-32+byte"

# --- e.id OAuth SSO ---
# EID_MODE: "mock" (default, tanpa credentials) | "sandbox" | "production"
EID_MODE="mock"
EID_OAUTH_BASE_URL="https://api-dev.e.id"
EID_OAUTH_CLIENT_ID=""
EID_OAUTH_CLIENT_SECRET=""
EID_OAUTH_CALLBACK_URL="http://localhost:3000/api/auth/eid/callback"

# --- e.id Issuer (credential) ---
EID_ISSUER_BASE_URL="https://gateway-sandbox.e.id"
EID_ISSUER_CLIENT_ID=""
EID_ISSUER_CLIENT_SECRET=""
EID_WEBHOOK_SECRET=""

# --- GA4 (opsional; tanpa PII peserta) ---
NEXT_PUBLIC_GA_ID=""

# --- UI mode badge (cermin publik EID_MODE, tanpa secret) ---
NEXT_PUBLIC_EID_MODE="mock"

# --- Storage (opsional untuk MVP; S3-compatible) ---
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
